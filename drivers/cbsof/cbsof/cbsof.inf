;
; cbsof.inf - open SOF audio driver for Gemini Lake Chromebooks
; Milestone 4a: Windows "Speakers" endpoint on the SOF speaker pipeline.
; Based on Microsoft SimpleAudioSample.inx (MS-PL).
;

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 11/14/2026,0.6.4.0
CatalogFile = cbsof.cat
PnpLockdown = 1

[SourceDisksNames]
222 = %DiskName%,"",222

[SourceDisksFiles]
cbsof.sys  = 222
sof-glk.ri = 222
spk.cbtp   = 222
mic.cbtp   = 222
dmic.cbtp  = 222

[SignatureAttributes]
cbsof.sys = SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel = 1300

[SignatureAttributes.PETrust]
PETrust = true

[Manufacturer]
%MfgName% = CBSOF,NT$ARCH$.10.0...16299

[CBSOF.NT$ARCH$.10.0...16299]
%CBSOF.DeviceDesc% = CBSOF_SA, CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_3198

; cbsof.sys runs from this package's own driver-store folder (DIRID 13), so an
; older cbsof package can never overwrite the binary of a newer one (that is
; how 0.4 kept loading after 0.4.1 was installed). The firmware files are the
; same in every version and stay in System32\drivers\cbsof.
[DestinationDirs]
CBSOF_SA.CopyList = 13
CBSOF_SA.FwList   = 12,cbsof

[CBSOF_SA.CopyList]
cbsof.sys

[CBSOF_SA.FwList]
sof-glk.ri
spk.cbtp
mic.cbtp
dmic.cbtp

[CBSOF_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,cbsof.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%CBSOF.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%CBSOF.DeviceDesc%
; Idle the device (and reboot the DSP on the next sound) only after 30 s of
; silence, instead of PortCls's few seconds.
HKR,PowerSettings,ConservationIdleTime,3,30,0,0,0
HKR,PowerSettings,PerformanceIdleTime,3,30,0,0,0
HKR,PowerSettings,IdlePowerState,3,3,0,0,0

[CBSOF.I.WaveSpeaker]
AddReg = CBSOF.I.WaveSpeaker.AddReg

[CBSOF.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CBSOF.WaveSpeaker.szPname%

[CBSOF.I.TopologySpeaker]
AddReg = CBSOF.I.TopologySpeaker.AddReg

[CBSOF.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CBSOF.TopologySpeaker.szPname%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

[CBSOF.I.WaveHeadphones]
AddReg = CBSOF.I.WaveHeadphones.AddReg

[CBSOF.I.WaveHeadphones.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CBSOF.WaveHeadphones.szPname%

[CBSOF.I.TopologyHeadphones]
AddReg = CBSOF.I.TopologyHeadphones.AddReg

[CBSOF.I.TopologyHeadphones.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CBSOF.TopologyHeadphones.szPname%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

[CBSOF.I.WaveMic]
AddReg = CBSOF.I.WaveMic.AddReg

[CBSOF.I.WaveMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CBSOF.WaveMic.szPname%

[CBSOF.I.TopologyMic]
AddReg = CBSOF.I.TopologyMic.AddReg

[CBSOF.I.TopologyMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CBSOF.TopologyMic.szPname%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

[CBSOF.I.WaveMicIn]
AddReg = CBSOF.I.WaveMicIn.AddReg

[CBSOF.I.WaveMicIn.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CBSOF.WaveMicIn.szPname%

[CBSOF.I.TopologyMicIn]
AddReg = CBSOF.I.TopologyMicIn.AddReg

[CBSOF.I.TopologyMicIn.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CBSOF.TopologyMicIn.szPname%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

[CBSOF_SA.NT]
Include = ks.inf,wdmaudio.inf
Needs   = KS.Registration, WDMAUDIO.Registration
CopyFiles = CBSOF_SA.CopyList, CBSOF_SA.FwList
AddReg  = CBSOF_SA.AddReg

[CBSOF_SA.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveSpeaker%,     CBSOF.I.WaveSpeaker
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveSpeaker%,     CBSOF.I.WaveSpeaker
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%,     CBSOF.I.WaveSpeaker
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologySpeaker%, CBSOF.I.TopologySpeaker
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, CBSOF.I.TopologySpeaker
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveHeadphones%,     CBSOF.I.WaveHeadphones
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveHeadphones%,     CBSOF.I.WaveHeadphones
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveHeadphones%,     CBSOF.I.WaveHeadphones
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyHeadphones%, CBSOF.I.TopologyHeadphones
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyHeadphones%, CBSOF.I.TopologyHeadphones
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveDmic%,        CBSOF.I.WaveMic
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveDmic%,        CBSOF.I.WaveMic
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveDmic%,        CBSOF.I.WaveMic
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyDmic%,    CBSOF.I.TopologyMic
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyDmic%,    CBSOF.I.TopologyMic
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveMicIn%,       CBSOF.I.WaveMicIn
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicIn%,       CBSOF.I.WaveMicIn
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveMicIn%,       CBSOF.I.WaveMicIn
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicIn%,   CBSOF.I.TopologyMicIn
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicIn%,   CBSOF.I.TopologyMicIn

[CBSOF_SA.NT.Services]
AddService = cbsof, 0x00000002, Cbsof_Service_Inst

[Cbsof_Service_Inst]
DisplayName   = %CBSOF.SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\cbsof.sys

[CBSOF_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[CBSOF_SA.NT.Wdf]
KmdfService = cbsof, CBSOF_SA_WdfSect

[CBSOF_SA_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
KSNAME_WaveSpeaker     = "WaveSpeaker"
KSNAME_TopologySpeaker = "TopologySpeaker"
KSNAME_WaveHeadphones     = "WaveHeadphones"
KSNAME_TopologyHeadphones = "TopologyHeadphones"
KSNAME_WaveDmic        = "WaveDmic"
KSNAME_TopologyDmic    = "TopologyDmic"
KSNAME_WaveMicIn       = "WaveMicIn"
KSNAME_TopologyMicIn   = "TopologyMicIn"

Proxy.CLSID          = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO     = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER    = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE   = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME  = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY  = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY       = "{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"

ProviderName = "Chromebook SOF Audio (open)"
MfgName      = "Chromebook SOF Audio (open)"
DiskName     = "Chromebook SOF Audio Disk"
CBSOF.DeviceDesc = "Chromebook SOF Audio (open)"
CBSOF.SvcDesc    = "Chromebook SOF Audio (open)"
CBSOF.WaveSpeaker.szPname     = "Speakers"
CBSOF.TopologySpeaker.szPname = "Speakers"
CBSOF.WaveHeadphones.szPname     = "Headphones"
CBSOF.TopologyHeadphones.szPname = "Headphones"
CBSOF.WaveMic.szPname         = "Microphone"
CBSOF.TopologyMic.szPname     = "Microphone"
CBSOF.WaveMicIn.szPname       = "Headset Microphone"
CBSOF.TopologyMicIn.szPname   = "Headset Microphone"
